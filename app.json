{
  "expo": {
    "name": "Gizli Dualar",
    "slug": "gizli-dualar",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gizldualarapplication.gizlidualar",
      "buildNumber": "20"
    },
    "android": {
      "versionCode": 20,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.gizldualarapplication.gizlidualar"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6c6045d8-7425-41d9-993b-9be2998e9f2a"
      }
    },
    "plugins": [
      "expo-localization"
     
    ]
  }
}
